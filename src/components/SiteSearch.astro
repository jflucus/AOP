---
import { mentors, board, advisoryCouncil, successModel, outcomes } from '../data';
import { nav } from '../config';

const pages = [
  ...nav,
  { label: 'Donate', href: '/donate/' },
  { label: 'Apply to AOP', href: '/apply/' },
  { label: 'College Acceptances', href: '/college-acceptances/' },
];

const people = [...mentors, ...board, ...advisoryCouncil].filter((p) => p.bio);

const searchIndex = [
  ...pages.map((p) => ({
    title: p.label,
    url: p.href,
    type: 'Page',
    keywords: p.label,
  })),
  ...people.map((p) => ({
    title: p.name,
    url: `/team/${p.slug}/`,
    type: 'Team',
    keywords: `${p.name} ${p.role} ${'focus' in p ? p.focus ?? '' : ''}`,
  })),
  ...successModel.map((phase) => ({
    title: phase.name,
    url: `/programs/#${phase.slug}`,
    type: 'Program',
    keywords: `${phase.name} ${phase.summary}`,
  })),
  ...outcomes.map((o) => ({
    title: o.title,
    url: '/about/',
    type: 'Outcome',
    keywords: `${o.title} ${o.summary}`,
  })),
];
---

<div class="site-search" data-site-search>
  <label class="sr-only" for="site-search-input">Search the site</label>
  <input
    id="site-search-input"
    class="site-search__input"
    type="search"
    placeholder="Search the site: mentors, programs, donate, apply…"
    autocomplete="off"
    data-search-input
  />
  <ul class="site-search__results" data-search-results hidden></ul>
</div>

<script type="application/json" id="site-search-index" set:html={JSON.stringify(searchIndex)} />

<script>
  function initSiteSearch(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLUListElement>('[data-search-results]');
    const indexEl = document.getElementById('site-search-index');
    if (!input || !results || !indexEl) return;

    const index: { title: string; url: string; type: string; keywords: string }[] = JSON.parse(
      indexEl.textContent || '[]'
    );

    function render(matches: typeof index) {
      if (!results) return;
      results.innerHTML = '';
      if (matches.length === 0) {
        results.hidden = true;
        return;
      }
      matches.slice(0, 8).forEach((m) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = m.url;
        a.innerHTML = `<span class="site-search__result-title">${m.title}</span><span class="site-search__result-type">${m.type}</span>`;
        li.appendChild(a);
        results.appendChild(li);
      });
      results.hidden = false;
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        render([]);
        return;
      }
      const matches = index.filter((item) => item.keywords.toLowerCase().includes(q));
      render(matches);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.blur();
        render([]);
      }
      if (e.key === 'Enter') {
        const first = results?.querySelector('a');
        if (first) window.location.href = (first as HTMLAnchorElement).href;
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) {
        render([]);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-site-search]').forEach(initSiteSearch);
</script>

<style>
  .site-search {
    position: relative;
    width: 100%;
  }
  .site-search__input {
    width: 100%;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 1rem;
    font-family: inherit;
    color: var(--navy);
    background: #fff;
  }
  .site-search__input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .site-search__results {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    max-height: 340px;
    overflow-y: auto;
    text-align: left;
  }
  .site-search__results li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.7rem;
    border-radius: 8px;
    color: var(--navy);
    text-decoration: none;
  }
  .site-search__results li a:hover,
  .site-search__results li a:focus {
    background: var(--sky);
  }
  .site-search__result-title {
    font-weight: 600;
  }
  .site-search__result-type {
    flex: 0 0 auto;
    font-size: 0.78rem;
    color: var(--gold-dark);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
