---
export interface Props {
  name:
    | 'calendar'
    | 'pin'
    | 'clock'
    | 'check'
    | 'notebook'
    | 'backpack'
    | 'scissors'
    | 'health'
    | 'food'
    | 'gift'
    | 'cap'
    | 'dollar'
    | 'briefcase';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'calendar' && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <line x1="8" y1="3" x2="8" y2="7" />
      <line x1="16" y1="3" x2="16" y2="7" />
    </>
  )}
  {name === 'pin' && (
    <>
      <circle cx="12" cy="10" r="6" />
      <circle cx="12" cy="10" r="2" fill="currentColor" stroke="none" />
      <line x1="12" y1="16" x2="12" y2="21" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <line x1="12" y1="12" x2="12" y2="7" />
      <line x1="12" y1="12" x2="15.5" y2="14" />
    </>
  )}
  {name === 'check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polyline points="8,12.5 11,15.5 16,9.5" />
    </>
  )}
  {name === 'notebook' && (
    <>
      <rect x="5" y="4" width="14" height="16" rx="1.5" />
      <line x1="9" y1="9" x2="15" y2="9" />
      <line x1="9" y1="13" x2="15" y2="13" />
      <line x1="9" y1="17" x2="13" y2="17" />
    </>
  )}
  {name === 'backpack' && (
    <>
      <rect x="6" y="8" width="12" height="13" rx="2" />
      <rect x="9" y="8" width="6" height="4" rx="1" />
      <line x1="9" y1="13" x2="15" y2="13" />
    </>
  )}
  {name === 'scissors' && (
    <>
      <circle cx="6" cy="6" r="2.5" />
      <circle cx="6" cy="18" r="2.5" />
      <line x1="8" y1="8" x2="20" y2="18" />
      <line x1="8" y1="16" x2="20" y2="6" />
    </>
  )}
  {name === 'health' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <line x1="12" y1="8" x2="12" y2="16" />
      <line x1="8" y1="12" x2="16" y2="12" />
    </>
  )}
  {name === 'food' && (
    <>
      <circle cx="12" cy="7" r="3.5" />
      <line x1="12" y1="10.5" x2="12" y2="21" />
    </>
  )}
  {name === 'gift' && (
    <>
      <rect x="4" y="6" width="16" height="3" rx="1" />
      <rect x="4" y="9" width="16" height="11" rx="1" />
      <line x1="4" y1="13.5" x2="20" y2="13.5" />
      <line x1="12" y1="9" x2="12" y2="20" />
    </>
  )}
  {name === 'cap' && (
    <>
      <polygon points="12,4 22,9 12,14 2,9" />
      <polyline points="6,11 6,15 12,17.5 18,15 18,11" />
      <line x1="12" y1="14" x2="12" y2="19" />
    </>
  )}
  {name === 'dollar' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <text x="12" y="16" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor" stroke="none">$</text>
    </>
  )}
  {name === 'briefcase' && (
    <>
      <rect x="3" y="8" width="18" height="12" rx="2" />
      <polyline points="8,8 8,5 16,5 16,8" />
      <line x1="3" y1="13" x2="21" y2="13" />
    </>
  )}
</svg>
