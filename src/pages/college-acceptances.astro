---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { collegeAcceptances, acceptedSchools, totalScholarshipsEarned } from '../data';

const formattedTotal = `$${totalScholarshipsEarned.toLocaleString('en-US')}`;

const schools = acceptedSchools
  .map((school) => ({
    school,
    students: collegeAcceptances.filter((c) => c.school === school).map((c) => c.name),
  }))
  .sort((a, b) => a.school.localeCompare(b.school));

const midpoint = Math.ceil(schools.length / 2);
const columns = [schools.slice(0, midpoint), schools.slice(midpoint)];
---

<Base
  title="College Acceptances"
  description="Every school our NYC-based AOP Foundation scholars have been accepted to."
>
  <PageHero
    eyebrow="College Acceptances"
    title="Every school our scholars have gotten into"
    intro={`So far, our scholars have earned ${formattedTotal} in college scholarships along the way.`}
  />

  <section class="section">
    <div class="container">
      <div class="school-columns">
        {columns.map((column) => (
          <ul class="school-list">
            {column.map((s) => (
              <li class="school-list__item">
                <h3>{s.school}</h3>
                <ul class="school-list__students">
                  {s.students.map((student) => <li>{student}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        ))}
      </div>

      <div class="callout">
        <h2>Help us add the next school to this list</h2>
        <p>
          Every acceptance here started with a mentor, a plan, and consistent support. Your donation funds
          the advising, test prep, and application help that gets the next scholar on this list.
        </p>
        <a class="btn btn--gold" href="/donate/">Donate</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .school-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
    max-width: 900px;
    align-items: start;
  }
  .school-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .school-list__item {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border);
  }
  .school-list__item:first-child {
    padding-top: 0;
  }

  @media (max-width: 640px) {
    .school-columns {
      grid-template-columns: 1fr;
    }
  }
  .school-list__item h3 {
    margin: 0 0 0.3rem;
  }
  .school-list__students {
    list-style: none;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
  }
  .school-list__students li {
    padding: 0.15rem 0;
  }
  .callout {
    margin-top: 2.5rem;
    background: var(--sky);
    border-radius: var(--radius);
    padding: 2rem;
    border-left: 5px solid var(--gold);
  }
  .callout h2 {
    margin-top: 0;
  }
</style>
