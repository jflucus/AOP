---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { foundingDonors } from '../data';
---

<Base
  title="Founding Donors"
  description="Thank you to the founding donors of AOP Foundation, whose early support makes our work possible."
>
  <PageHero
    eyebrow="Founding Donors"
    title="The people who believed first"
    intro="AOP Foundation exists because these supporters said yes early. Their generosity funds the mentorship, academics, and college guidance that turn talent into opportunity."
  />

  <section class="section">
    <div class="container">
      <ul class="donor-list">
        {foundingDonors.map((name) => (
          <li class="donor-card">{name}</li>
        ))}
      </ul>

      <div class="callout">
        <h2>Become a founding donor</h2>
        <p>
          We're still building our founding coalition. Every gift, at any level, helps launch the next
          cohort of AOP scholars.
        </p>
        <a class="btn btn--gold" href="/donate/">Donate</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .donor-list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    max-width: 900px;
  }
  .donor-card {
    background: #fff;
    border: 1px solid var(--border);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--navy);
    box-shadow: var(--shadow);
  }
  .callout {
    background: var(--sky);
    border-radius: var(--radius);
    padding: 2rem;
    border-left: 5px solid var(--gold);
  }
  .callout h2 {
    margin-top: 0;
  }
</style>
