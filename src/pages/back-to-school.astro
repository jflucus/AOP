---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { backToSchoolEvent, backToSchoolExpect, backToSchoolWhyItMatters } from '../data';

const participation = [
  {
    title: 'Families',
    body: 'Attend the event and connect with free resources.',
    cta: 'Register',
    href: backToSchoolEvent.registerUrl,
  },
  {
    title: 'Community Organizations & Vendors',
    body: 'Provide resources, services, information, or activities for Bronx families.',
    cta: 'Become a Partner',
    href: backToSchoolEvent.partnerUrl,
  },
  {
    title: 'Supporters',
    body: 'Help AOP provide supplies, food, incentives, and student resources.',
    cta: 'Donate',
    href: '/donate/',
  },
];

const impactExamples = [
  ['$25', 'helps provide student supplies'],
  ['$50', 'supports event resources'],
  ['$100', 'helps equip multiple students'],
];
---

<Base
  title="Back-to-School Community Kickoff"
  description={`${backToSchoolEvent.name} — ${backToSchoolEvent.date}, ${backToSchoolEvent.venue}. A free event helping Bronx students start the school year prepared, healthy, and ready to attend.`}
>
  <PageHero
    eyebrow="Back-to-School Community Kickoff"
    title="A day of resources. A lifetime of impact."
    intro={`Presented with ${backToSchoolEvent.presentedWith}. ${backToSchoolEvent.date} · ${backToSchoolEvent.time} · ${backToSchoolEvent.venue}, ${backToSchoolEvent.address}`}
  />

  <section class="section">
    <div class="container event-hero">
      <div>
        <img class="event-hero__flyer" src={backToSchoolEvent.flyer} alt={`${backToSchoolEvent.name} flyer`} loading="eager" />
        <p class="event-hero__partner">
          <img src="/events/bronx-burners-logo.jpg" alt={`${backToSchoolEvent.presentedWith} logo`} width="40" height="40" />
          Presented with {backToSchoolEvent.presentedWith}
        </p>
      </div>
      <div>
        <p class="eyebrow">Free for students and families</p>
        <h2>Before Day One, let's make attendance a priority.</h2>
        <p class="lead">
          This isn't just a giveaway — it's an attendance initiative. Every student leaves knowing school
          matters, their community supports them, and they're expected in class.
        </p>
        <a class="btn btn--gold" href={backToSchoolEvent.registerUrl} target="_blank" rel="noopener">
          Register Your Interest &rarr;
        </a>
        <div class="event-hero__expect">
          {backToSchoolExpect.map(([icon, label]) => (
            <div class="event-hero__expect-item">
              <Icon name={icon as any} size={26} />
              <span>{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Why This Matters</p>
        <h2>More Than a Giveaway</h2>
        <p class="lead">
          AOP Foundation's Back-to-School Community Kickoff is an attendance and student-engagement
          initiative. We're bringing students, families, schools, and community partners together to
          remove barriers that can prevent students from starting the school year strong.
        </p>
        <p class="lead">
          Our goal is simple: help students arrive prepared, connected, and ready to attend school from
          Day One.
        </p>
      </div>
      <ul class="why-list">
        {backToSchoolWhyItMatters.map((item) => (
          <li>✅ {item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--navy cohort-band">
    <div class="container center">
      <p class="eyebrow">Our Impact</p>
      <div class="stat">
        <span class="stat__num">16</span>
        <p>Bronx seniors mentored in our volunteer pilot last year — 100% graduated, 100% completed
          financial aid, 100% enrolled in college.</p>
      </div>
      <blockquote class="event-quote">
        “Because someone believed in me, I started school ready, graduated, and am now attending college.”
        <cite>— AOP Mentee</cite>
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Get Involved</p>
        <h2>Help Us Start the School Year Strong</h2>
      </div>
      <div class="grid grid--3" style="margin-top:2.5rem;">
        {participation.map((p) => (
          <article class="card participation-card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <a class="btn btn--navy" href={p.href} target="_blank" rel="noopener">{p.cta} &rarr;</a>
          </article>
        ))}
      </div>

      <div class="callout">
        <h2>What your gift can do</h2>
        <div class="impact-row">
          {impactExamples.map(([amount, desc]) => (
            <p><strong>{amount}</strong> {desc}</p>
          ))}
        </div>
        <a class="btn btn--gold" href="/donate/">Donate</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .event-hero {
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .event-hero__flyer {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .event-hero__partner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .event-hero__partner img {
    border-radius: 50%;
  }
  .event-hero__expect {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    margin-top: 1.75rem;
  }
  .event-hero__expect-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--navy);
    max-width: 90px;
    text-align: center;
  }
  .event-hero__expect-item svg {
    color: var(--gold-dark);
  }
  .why-list {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    max-width: 640px;
    display: grid;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--navy);
  }
  .cohort-band .stat {
    max-width: 520px;
    margin-inline: auto;
  }
  .cohort-band .stat__num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.4rem);
    color: var(--gold-light);
    line-height: 1;
    display: block;
  }
  .cohort-band .stat p {
    color: #c9d6e8;
  }
  .event-quote {
    margin: 2rem auto 0;
    max-width: 560px;
    font-size: 1.2rem;
    font-weight: 500;
    font-style: italic;
    color: #fff;
    line-height: 1.4;
  }
  .event-quote cite {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.95rem;
    font-style: normal;
    font-weight: 700;
    color: var(--gold-light);
  }
  .participation-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .participation-card .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .callout {
    margin-top: 2.5rem;
    background: var(--sky);
    border-radius: var(--radius);
    padding: 2rem;
    border-left: 5px solid var(--gold);
    text-align: center;
  }
  .callout h2 {
    margin-top: 0;
  }
  .impact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 1rem 0 1.5rem;
    color: var(--text-muted);
  }
  .impact-row strong {
    color: var(--gold-dark);
  }

  @media (max-width: 700px) {
    .event-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .event-hero__flyer {
      max-width: 320px;
      margin-inline: auto;
    }
    .event-hero__expect {
      justify-content: center;
    }
  }
</style>
