---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { backToSchoolEvent, backToSchoolExpect, backToSchoolWhyItMatters } from '../data';

const galleryPhotos = [
  {
    src: '/events/backpack-giveaway-1.jpg',
    alt: 'AOP staff member and two students with new backpacks at the Back-to-School Community Kickoff.',
    aspect: '4 / 3',
  },
  {
    src: '/events/backpack-giveaway-2.jpg',
    alt: 'A family holding new clothing and backpacks at the Back-to-School Community Kickoff.',
    aspect: '3 / 4',
  },
  {
    src: '/events/backpack-giveaway-3.jpg',
    alt: 'AOP coaches and students holding gift cards at the Back-to-School Community Kickoff.',
    aspect: '4 / 3',
  },
];

const nextSteps = [
  {
    title: 'Supporters',
    body: 'Help fund the next community event and year-round programming.',
    cta: 'Donate',
    href: '/donate/',
  },
  {
    title: 'Community Organizations & Vendors',
    body: 'Bring resources, services, or activities to our next community event.',
    cta: 'Partner With Us',
    href: '/partners/',
  },
  {
    title: 'Families & Community',
    body: 'Get notified about our next community event and program updates.',
    cta: 'See News & Events',
    href: '/news/',
  },
];
---

<Base
  title="Back-to-School Community Kickoff — Event Recap"
  description={`See how AOP Foundation and ${backToSchoolEvent.presentedWith} helped Bronx families start the school year strong at the Back-to-School Community Kickoff on ${backToSchoolEvent.date}.`}
>
  <PageHero
    eyebrow="Event Recap"
    title="Backpacks Delivered. Promises Kept."
    intro={`On ${backToSchoolEvent.date}, AOP Foundation teamed up with ${backToSchoolEvent.presentedWith} at ${backToSchoolEvent.venue} to help Bronx families start the school year strong.`}
  />

  <section class="section">
    <div class="container">
      <div class="event-gallery">
        {galleryPhotos.map((photo) => (
          <img
            class="event-gallery__photo"
            src={photo.src}
            alt={photo.alt}
            style={`aspect-ratio: ${photo.aspect};`}
            loading="lazy"
          />
        ))}
      </div>
      <p class="event-gallery__partner">
        <img src="/events/bronx-burners-logo.jpg" alt={`${backToSchoolEvent.presentedWith} logo`} width="40" height="40" />
        Presented with {backToSchoolEvent.presentedWith}
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container center">
      <p class="eyebrow">What We Provided</p>
      <h2>Everything Families Needed to Start the Year Strong</h2>
    </div>
    <div class="container">
      <div class="event-hero__expect event-hero__expect--center">
        {backToSchoolExpect.map(([icon, label]) => (
          <div class="event-hero__expect-item">
            <Icon name={icon as any} size={26} />
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Why This Mattered</p>
        <h2>More Than a Giveaway</h2>
        <p class="lead">
          AOP Foundation's Back-to-School Community Kickoff was an attendance and
          student-engagement initiative. We brought students, families, schools, and community
          partners together to remove barriers that can keep students from starting the school
          year strong.
        </p>
      </div>
      <ul class="why-list">
        {backToSchoolWhyItMatters.map((item) => (
          <li>✅ {item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--navy cohort-band">
    <div class="container center">
      <p class="eyebrow">Our Track Record</p>
      <div class="stat">
        <span class="stat__num">16</span>
        <p>Bronx seniors mentored in our volunteer pilot last year — 100% graduated, 100% completed
          financial aid, 100% enrolled in college.</p>
      </div>
      <blockquote class="event-quote">
        “Because someone believed in me, I started school ready, graduated, and am now attending college.”
        <cite>— AOP Mentee</cite>
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Help Us Do This Again</p>
        <h2>Support Our Next Community Event</h2>
      </div>
      <div class="grid grid--3" style="margin-top:2.5rem;">
        {nextSteps.map((p) => (
          <article class="card participation-card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <a class="btn btn--navy" href={p.href}>{p.cta} &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .event-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .event-gallery__photo {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .event-gallery__partner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .event-gallery__partner img {
    border-radius: 50%;
  }
  .event-hero__expect {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    margin-top: 1.75rem;
  }
  .event-hero__expect--center {
    justify-content: center;
  }
  .event-hero__expect-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--navy);
    max-width: 90px;
    text-align: center;
  }
  .event-hero__expect-item svg {
    color: var(--gold-dark);
  }
  .why-list {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    max-width: 640px;
    display: grid;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--navy);
  }
  .cohort-band .stat {
    max-width: 520px;
    margin-inline: auto;
  }
  .cohort-band .stat__num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.4rem);
    color: var(--gold-light);
    line-height: 1;
    display: block;
  }
  .cohort-band .stat p {
    color: #c9d6e8;
  }
  .event-quote {
    margin: 2rem auto 0;
    max-width: 560px;
    font-size: 1.2rem;
    font-weight: 500;
    font-style: italic;
    color: #fff;
    line-height: 1.4;
  }
  .event-quote cite {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.95rem;
    font-style: normal;
    font-weight: 700;
    color: var(--gold-light);
  }
  .participation-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .participation-card .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 700px) {
    .event-gallery {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
