---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config';

const giftImpact: [string, string][] = [
  ['$25', 'Helps provide program materials and supplies for student-athletes.'],
  ['$50', 'Helps provide academic support, tutoring resources, and student workshops.'],
  ['$150', 'Helps fund one month of mentorship for one AOP student-athlete.'],
  ['$450', 'Helps fund three months of mentorship for one AOP student-athlete.'],
  ['$900', 'Helps fund six months of mentorship for one AOP student-athlete.'],
  [
    '$1,000',
    'Founding Donor — provides significant support toward mentoring, academic programming, workshops, and student opportunities.',
  ],
  ['$1,800', 'Helps fund one full year of mentorship for one AOP student-athlete.'],
];

const hasDonateOptions = site.donateOptions.length > 0;
---

<Base title="Donate" description="Invest in a student-athlete's future. Your gift funds mentorship, academic support, college and career preparation, leadership development, and community programming for NYC student-athletes.">
  <PageHero
    eyebrow="Donate"
    title="Invest in a Student-Athlete's Future"
    intro="Your gift helps Athletes of Promise Foundation provide student-athletes with consistent mentorship, academic support, college and career preparation, leadership development, community programming, and access to educational opportunities."
  />

  <section class="section">
    <div class="container center">
      <p class="eyebrow">Gift Impact</p>
      <h2>See What Your Gift Can Help Make Possible</h2>
    </div>
    <div class="container table-wrap">
      <table class="gift-table">
        <thead>
          <tr>
            <th>Your Gift</th>
            <th>Your Impact</th>
          </tr>
        </thead>
        <tbody>
          {giftImpact.map(([amount, impact]) => (
            <tr>
              <td class="gift-table__amount">{amount}</td>
              <td>{impact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2" style="gap:3rem; align-items:start;">
      <div>
        <p class="eyebrow">Every Gift Builds Opportunity</p>
        <h2>A financial plan built around student-athletes</h2>
        <p class="lead">
          AOP's financial plan directs resources toward the services young people need most:
          mentoring, academic support and tutoring, student programs and workshops, community
          resource events, and the Scholarship &amp; Opportunity Fund, which provides charitable
          assistance to students for educational, athletic, leadership, and career-development
          purposes.
        </p>
        <p class="lead"><strong>Make a one-time gift or become a monthly supporter today.</strong></p>
      </div>

      <aside class="donate-box" id="donate-info">
        <h3>Give to AOP Foundation</h3>
        <p class="trust-badge">501(c)(3) Public Charity</p>
        {hasDonateOptions ? (
          <>
            <p>Make a secure gift online.</p>
            <a class="btn btn--gold btn--block" href={site.donateCustomUrl} target="_blank" rel="noopener">
              Donate any amount
            </a>
            <p class="donate-or">or choose an amount</p>
            <div class="donate-amounts">
              {site.donateOptions.map((opt) => (
                <a class="btn btn--ghost" href={opt.url} target="_blank" rel="noopener">
                  ${opt.amount}
                </a>
              ))}
            </div>
          </>
        ) : (
          <>
            <p class="notice">
              <strong>Our online donation page is being set up.</strong> To give now or pledge support,
              email us and we'll send secure giving instructions.
            </p>
            <a class="btn btn--gold btn--block" href={`mailto:${site.email}?subject=I'd like to donate to AOP Foundation`}>
              Email us to give
            </a>
          </>
        )}
        <p class="donate-box__fine">
          Athletes of Promise Foundation, Inc. is an IRS-recognized 501(c)(3) public charity. Your
          contribution is tax-deductible to the extent permitted by law.
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container narrow center">
      <h2>Your Gift Is Tax-Deductible</h2>
      <p class="lead">
        Athletes of Promise Foundation, Inc. is recognized by the Internal Revenue Service as a
        tax-exempt organization under Section 501(c)(3) and is classified as a public charity.
        Contributions are tax-deductible to the extent permitted by law.
      </p>
      <p class="fine-note">
        No goods or services are provided in exchange for contributions unless otherwise stated.
      </p>
    </div>
  </section>

  <section class="section section--navy cta-band">
    <div class="container center">
      <h2>Other ways to give</h2>
      <p class="lead">Equipment, in-kind services, employer sponsorships, and volunteer time all move scholars forward.</p>
      <div class="cta-row">
        <a class="btn btn--ghost" href="/get-involved/">See ways to get involved</a>
        <a class="btn btn--ghost" href="/shop/">Shop AOP gear</a>
        <a class="btn btn--ghost" href="/donors/">Meet our founding donors</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .narrow {
    max-width: 700px;
  }
  .table-wrap {
    margin-top: 2rem;
    overflow-x: auto;
  }
  .gift-table {
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
    border-collapse: collapse;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .gift-table th {
    background: var(--navy);
    color: #fff;
    text-align: left;
    padding: 0.9rem 1.2rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .gift-table td {
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--border);
    color: var(--navy);
  }
  .gift-table tr:last-child td {
    border-bottom: none;
  }
  .gift-table__amount {
    font-weight: 800;
    color: var(--gold-dark);
    white-space: nowrap;
    width: 1%;
  }
  .fine-note {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .donate-box {
    background: #fff;
    border: 1px solid var(--border);
    border-top: 5px solid var(--gold);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 96px;
  }
  .donate-box h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .trust-badge {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.3rem 0.7rem;
    background: var(--sky);
    border: 1px solid var(--gold);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--gold-dark);
  }
  .btn--block {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 1rem 0;
  }
  .donate-or {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0.75rem 0 0.5rem;
  }
  .donate-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .donate-amounts .btn {
    flex: 1 1 auto;
    min-width: 90px;
    justify-content: center;
  }
  .notice {
    background: var(--sky);
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .donate-box__fine {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 700px) {
    .gift-table {
      min-width: 560px;
    }
  }
</style>
