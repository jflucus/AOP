---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config';

const supports = [
  ['📚', 'Tutoring & academic support'],
  ['🏈', 'Athletic equipment'],
  ['⭐', 'Leadership workshops'],
  ['🎓', 'Scholarship assistance'],
  ['🚌', 'College visits'],
  ['🧑‍🏫', 'Mentoring'],
  ['💼', 'Career exploration'],
];

const hasDonateOptions = site.donateOptions.length > 0;
---

<Base title="Donate" description="Support tutoring, athletic equipment, leadership workshops, scholarship assistance, college visits, mentoring, and career exploration for NYC student-athletes.">
  <PageHero
    eyebrow="Donate"
    title="Invest in a young person's promise"
    intro="Your gift funds the tutoring, mentoring, equipment, and college guidance that turn talent and drive into college acceptance, financial aid, and a career of purpose."
  />

  <section class="section">
    <div class="container grid grid--2" style="gap:3rem; align-items:start;">
      <div>
        <p class="eyebrow">Where your gift goes</p>
        <h2>Every dollar is stewarded transparently</h2>
        <ul class="support-list">
          {supports.map(([icon, label]) => (
            <li><span aria-hidden="true">{icon}</span> {label}</li>
          ))}
        </ul>
        <p class="benchmark">
          For reference, the intensive one-on-one advising model AOP is built on runs about
          <strong>$4,000 per student per year</strong>, and independent research ties it to higher college
          completion. We track cost-per-scholar and report it to our supporters.
        </p>
      </div>

      <aside class="donate-box" id="donate-info">
        <h3>Give to AOP Foundation</h3>
        {hasDonateOptions ? (
          <>
            <p>Make a secure gift online.</p>
            <a class="btn btn--gold btn--block" href={site.donateCustomUrl} target="_blank" rel="noopener">
              Donate any amount
            </a>
            <p class="donate-or">or choose an amount</p>
            <div class="donate-amounts">
              {site.donateOptions.map((opt) => (
                <a class="btn btn--ghost" href={opt.url} target="_blank" rel="noopener">
                  ${opt.amount}
                </a>
              ))}
            </div>
          </>
        ) : (
          <>
            <p class="notice">
              <strong>Our online donation page is being set up.</strong> To give now or pledge support,
              email us and we'll send secure giving instructions.
            </p>
            <a class="btn btn--gold btn--block" href={`mailto:${site.email}?subject=I'd like to donate to AOP Foundation`}>
              Email us to give
            </a>
          </>
        )}
        <p class="donate-box__fine">
          Athletes of Promise Foundation, Inc. has applied to the IRS for recognition as a tax-exempt
          organization under Section 501(c)(3). If approved, its exemption is expected to be effective
          retroactively to its date of incorporation. Donors should consult their tax advisers regarding
          deductibility while the application remains pending.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--navy cta-band">
    <div class="container center">
      <h2>Other ways to give</h2>
      <p class="lead">Equipment, in-kind services, employer sponsorships, and volunteer time all move scholars forward.</p>
      <div class="cta-row">
        <a class="btn btn--ghost" href="/get-involved/">See ways to get involved</a>
        <a class="btn btn--ghost" href="/shop/">Shop AOP gear</a>
        <a class="btn btn--ghost" href="/donors/">Meet our founding donors</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .support-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 0.6rem;
  }
  .support-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    color: var(--navy);
  }
  .support-list span {
    font-size: 1.3rem;
  }
  .benchmark {
    color: var(--text-muted);
    font-size: 0.95rem;
    border-left: 3px solid var(--gold);
    padding-left: 1rem;
  }
  .donate-box {
    background: #fff;
    border: 1px solid var(--border);
    border-top: 5px solid var(--gold);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 96px;
  }
  .donate-box h3 {
    margin-top: 0;
  }
  .btn--block {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 1rem 0;
  }
  .donate-or {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0.75rem 0 0.5rem;
  }
  .donate-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .donate-amounts .btn {
    flex: 1 1 auto;
    min-width: 90px;
    justify-content: center;
  }
  .notice {
    background: var(--sky);
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .donate-box__fine {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
